@PACKAGE_INIT@

# daConfig.cmake — generated by MiraDAC's CMakeLists.txt
# Provides targets: da::daShared  da::daStatic

include(CMakeFindDependencyMacro)

# Propagate the SymEngine dependency when this build had WITH_SYMBOLIC=ON.
# The variable DA_WITH_SYMBOLIC_INSTALLED is baked in at install time.
set(_da_with_symbolic "@WITH_SYMBOLIC@")
if(_da_with_symbolic)
    # Consumers need SymEngine on their path too.
    # If SymEngine_DIR was set during the da build, record it here so
    # downstream find_dependency can locate it without extra hints.
    set(_da_symengine_dir "@SymEngine_DIR@")
    if(_da_symengine_dir AND NOT SymEngine_DIR)
        set(SymEngine_DIR "${_da_symengine_dir}")
    endif()
    find_dependency(SymEngine @DA_SYMENGINE_FIND_VERSION@ CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/daTargets.cmake")

check_required_components(da)
